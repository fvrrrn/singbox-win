# Per-user secrets and runtime state - must never be committed
config.json
subscription.txt
subs.txt
cache.db

# Binaries - fetched from SagerNet's release at install time and verified against
# $SbSha256 in bootstrap.ps1. The repo never carries them: tools/test-config-gen.ps1
# validates against the installed copy in Desktop\vpn. These entries stay so a stray
# copy can never be committed by accident.
sing-box.exe
libcronet.dll
sing-box.sha256

# Build/runtime junk
*.zip
*.log
log.txt
